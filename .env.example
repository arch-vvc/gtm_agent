# Copy to .env and fill in your own keys. Never commit .env.
# DB_URL matches the db service in docker-compose.yml.
DB_URL=postgresql://postgres:secret@db:5432/gtm
# Hostname of the Redis service. Defaults to "redis" if unset.
REDIS_HOST=redis
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
